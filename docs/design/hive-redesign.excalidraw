gle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1243862423, "version": 1, "versionNonce": 1800188483, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "border\n#303128", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "border\n#303128", "autoResize": true, "lineHeight": 1.25}, {"id": "e0015", "type": "rectangle", "x": 490, "y": 160, "width": 80, "height": 80, "angle": 0, "strokeColor": "#000000", "backgroundColor": "#d7b56d", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 619570853, "version": 1, "versionNonce": 505913793, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0016", "type": "text", "x": 490, "y": 246, "width": 47.040000000000006, "height": 30.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1324919353, "version": 1, "versionNonce": 776213900, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "accent\n#d7b56d", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "accent\n#d7b56d", "autoResize": true, "lineHeight": 1.25}, {"id": "e0017", "type": "text", "x": 40, "y": 300, "width": 399.84000000000003, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 442620899, "version": 1, "versionNonce": 806899910, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Five surfaces inside ~6% luminance. Only the gold\nbutton separates from the page. Everything else is\none brown-grey mass, and the grain overlay + radial\nglow on top cost more contrast.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Five surfaces inside ~6% luminance. Only the gold\nbutton separates from the page. Everything else is\none brown-grey mass, and the grain overlay + radial\nglow on top cost more contrast.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0018", "type": "text", "x": 580, "y": 130, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1599435268, "version": 1, "versionNonce": 418461139, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "1.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0019", "type": "text", "x": 608, "y": 130, "width": 604.8000000000001, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 269676600, "version": 1, "versionNonce": 255985077, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Same-luminance surfaces. Page, panel, card and border sit within a few percent\nof each other, so cards never read as cards and sections never read as sections.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Same-luminance surfaces. Page, panel, card and border sit within a few percent\nof each other, so cards never read as cards and sections never read as sections.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0020", "type": "text", "x": 580, "y": 188, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 884585952, "version": 1, "versionNonce": 2132084005, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "2.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0021", "type": "text", "x": 608, "y": 188, "width": 657.72, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1836494975, "version": 1, "versionNonce": 1349251824, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Gold tints everything: hero glow, mental-model panel, pinned banner, grain. It reads\nas sepia, not focus. State colors are desaturated too, so green/amber/red stop meaning.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Gold tints everything: hero glow, mental-model panel, pinned banner, grain. It reads\nas sepia, not focus. State colors are desaturated too, so green/amber/red stop meaning.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0022", "type": "text", "x": 580, "y": 246, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1999744785, "version": 1, "versionNonce": 1946412081, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "3.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0023", "type": "text", "x": 608, "y": 246, "width": 627.48, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1552984409, "version": 1, "versionNonce": 1287489454, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "11.5px UPPERCASE eyebrows (CATCH UP · VERIFY · HERDR · DISPATCHER · SYSTEM) are the\nloudest thing on every row and carry the least information.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "11.5px UPPERCASE eyebrows (CATCH UP · VERIFY · HERDR · DISPATCHER · SYSTEM) are the\nloudest thing on every row and carry the least information.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0024", "type": "text", "x": 580, "y": 304, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1066984056, "version": 1, "versionNonce": 772092315, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "4.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0025", "type": "text", "x": 608, "y": 304, "width": 680.4000000000001, "height": 16.875, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1048386556, "version": 1, "versionNonce": 351564608, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Task briefs render as monospace blocks. Feed and timeline are 13px prose with no grouping.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Task briefs render as monospace blocks. Feed and timeline are 13px prose with no grouping.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0026", "type": "text", "x": 580, "y": 344, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1289560150, "version": 1, "versionNonce": 2126508551, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "5.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0027", "type": "text", "x": 608, "y": 344, "width": 597.24, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1475216846, "version": 1, "versionNonce": 1927728187, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Every row has equal weight: a 'read 121 changes' catch-up looks exactly like an\n'accept this landed PR' verify. The eye has nowhere to start.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every row has equal weight: a 'read 121 changes' catch-up looks exactly like an\n'accept this landed PR' verify. The eye has nowhere to start.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0028", "type": "text", "x": 580, "y": 402, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1236683273, "version": 1, "versionNonce": 314395343, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "6.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0029", "type": "text", "x": 608, "y": 402, "width": 627.48, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 507088657, "version": 1, "versionNonce": 1795823849, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "The home hero says '6 items need you' but does not show them. The chat box under it\nis a second blank hero. 60% of the landing page is empty.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The home hero says '6 items need you' but does not show them. The chat box under it\nis a second blank hero. 60% of the landing page is empty.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0030", "type": "text", "x": 580, "y": 460, "width": 17.92, "height": 20.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 708506837, "version": 1, "versionNonce": 1469118511, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "7.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "7.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0031", "type": "text", "x": 608, "y": 460, "width": 468.72, "height": 16.875, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 652768598, "version": 1, "versionNonce": 2100080515, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Decoration (grain, grid, blur, glow) adds cost and no meaning.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Decoration (grain, grid, blur, glow) adds cost and no meaning.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0032", "type": "text", "x": 580, "y": 506, "width": 470.40000000000003, "height": 17.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0001", "roundness": null, "seed": 1811180650, "version": 1, "versionNonce": 168393880, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "All seven are fixable with tokens + layout, no new features.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "All seven are fixable with tokens + layout, no new features.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0033", "type": "frame", "x": 1360, "y": 0, "width": 900, "height": 700, "angle": 0, "strokeColor": "#bbbbbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 333377415, "version": 1, "versionNonce": 1347535309, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "name": "1 · Five rules for the redesign"}, {"id": "e0034", "type": "text", "x": 1400, "y": 30, "width": 453.6, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 1460814403, "version": 1, "versionNonce": 1504004732, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Five rules for the redesign", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Five rules for the redesign", "autoResize": true, "lineHeight": 1.25}, {"id": "e0035", "type": "text", "x": 1400, "y": 74, "width": 478.24000000000007, "height": 17.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 2133201996, "version": 1, "versionNonce": 1959386987, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "ADHD-first: glanceable → short → actionable → never repeated.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ADHD-first: glanceable → short → actionable → never repeated.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0036", "type": "rectangle", "x": 1400, "y": 120, "width": 44, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": {"type": 3}, "seed": 295334610, "version": 1, "versionNonce": 401991736, "isDeleted": false, "boundElements": [{"id": "e0037", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0037", "type": "text", "x": 1416.4, "y": 129.5, "width": 11.200000000000001, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 1159380354, "version": 1, "versionNonce": 2036236842, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "1", "fontSize": 20, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0036", "originalText": "1", "autoResize": true, "lineHeight": 1.25}, {"id": "e0038", "type": "text", "x": 1464, "y": 118, "width": 202.16000000000003, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 279172787, "version": 1, "versionNonce": 260573196, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "One job per screen.", "fontSize": 19, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One job per screen.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0039", "type": "text", "x": 1464, "y": 146, "width": 461.16, "height": 33.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 1329753548, "version": 1, "versionNonce": 1914012529, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Home = what needs you, now. Everything else is one click away\nand never competes with it.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Home = what needs you, now. Everything else is one click away\nand never competes with it.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0040", "type": "rectangle", "x": 1400, "y": 220, "width": 44, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": {"type": 3}, "seed": 1222328496, "version": 1, "versionNonce": 1656961616, "isDeleted": false, "boundElements": [{"id": "e0041", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0041", "type": "text", "x": 1416.4, "y": 229.5, "width": 11.200000000000001, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 1490376254, "version": 1, "versionNonce": 96907016, "isDeleted": false, "boundElements": null, "upda