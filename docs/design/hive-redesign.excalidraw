: 100, "groupIds": [], "frameId": "e0610", "roundness": {"type": 3}, "seed": 1481178213, "version": 1, "versionNonce": 609204989, "isDeleted": false, "boundElements": [{"id": "e0620", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0620", "type": "text", "x": 1150.32, "y": 3818.25, "width": 31.360000000000003, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 123405708, "version": 1, "versionNonce": 132585068, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Comb", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0619", "originalText": "Comb", "autoResize": true, "lineHeight": 1.25}, {"id": "e0621", "type": "text", "x": 1230, "y": 3810, "width": 657.72, "height": 33.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 178882997, "version": 1, "versionNonce": 594432878, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Progress is a honeycomb that fills through the day: landed = honey, running = blue rim,\nqueued = empty. One glance says how the day is going.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Progress is a honeycomb that fills through the day: landed = honey, running = blue rim,\nqueued = empty. One glance says how the day is going.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0622", "type": "rectangle", "x": 1120, "y": 3878, "width": 92, "height": 30, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": {"type": 3}, "seed": 183164572, "version": 1, "versionNonce": 291317712, "isDeleted": false, "boundElements": [{"id": "e0623", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0623", "type": "text", "x": 1146.4, "y": 3884.25, "width": 39.2, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 200528040, "version": 1, "versionNonce": 282459669, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Words", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0622", "originalText": "Words", "autoResize": true, "lineHeight": 1.25}, {"id": "e0624", "type": "text", "x": 1230, "y": 3876, "width": 619.9200000000001, "height": 33.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 1560817387, "version": 1, "versionNonce": 856039357, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Agents are workers, the chat is 'tell the hive', done work has 'landed'. No queen,\nno bees, no buzz: the metaphor stays in the nouns.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Agents are workers, the chat is 'tell the hive', done work has 'landed'. No queen,\nno bees, no buzz: the metaphor stays in the nouns.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0625", "type": "rectangle", "x": 1120, "y": 3944, "width": 92, "height": 30, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": {"type": 3}, "seed": 283246282, "version": 1, "versionNonce": 1648591715, "isDeleted": false, "boundElements": [{"id": "e0626", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0626", "type": "text", "x": 1142.48, "y": 3950.25, "width": 47.040000000000006, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 460059252, "version": 1, "versionNonce": 1059041858, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Motion", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0625", "originalText": "Motion", "autoResize": true, "lineHeight": 1.25}, {"id": "e0627", "type": "text", "x": 1230, "y": 3942, "width": 582.12, "height": 16.875, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 883575329, "version": 1, "versionNonce": 872567463, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "A running worker's hexagon breathes (opacity 70→100, 2s). Nothing else moves.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A running worker's hexagon breathes (opacity 70→100, 2s). Nothing else moves.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0628", "type": "text", "x": 1120, "y": 4020, "width": 324.8, "height": 25.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 480906313, "version": 1, "versionNonce": 145430294, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Where it turns into a gimmick", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Where it turns into a gimmick", "autoResize": true, "lineHeight": 1.25}, {"id": "e0629", "type": "text", "x": 1120, "y": 4056, "width": 687.96, "height": 16.875, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 147862077, "version": 1, "versionNonce": 375679553, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "✕  Honeycomb wallpaper or a hex grid background: it eats contrast, the exact problem today.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✕  Honeycomb wallpaper or a hex grid background: it eats contrast, the exact problem today.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0630", "type": "text", "x": 1120, "y": 4084, "width": 665.2800000000001, "height": 16.875, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 1234223653, "version": 1, "versionNonce": 2049194803, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "✕  Hexagonal cards or a hex-tiled kanban: unreadable titles, wasted space, no scan line.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✕  Hexagonal cards or a hex-tiled kanban: unreadable titles, wasted space, no scan line.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0631", "type": "text", "x": 1120, "y": 4112, "width": 680.4000000000001, "height": 16.875, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 428968843, "version": 1, "versionNonce": 569743465, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "✕  Brown surfaces everywhere: that is the current sepia. Brown is for ink, not for panels.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✕  Brown surfaces everywhere: that is the current sepia. Brown is for ink, not for panels.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0632", "type": "text", "x": 1120, "y": 4140, "width": 529.2, "height": 16.875, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 420313300, "version": 1, "versionNonce": 880440102, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "✕  Bee illustrations, buzzing loaders, 'the queen' anywhere in the UI.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✕  Bee illustrations, buzzing loaders, 'the queen' anywhere in the UI.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0633", "type": "text", "x": 1120, "y": 4182, "width": 627.2, "height": 17.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 1264693502, "version": 1, "versionNonce": 1370691053, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Result: it reads as hive from across the room, and as a plain document up close.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Result: it reads as hive from across the room, and as a plain document up close.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0634", "type": "frame", "x": 0, "y": 4400, "width": 1440, "height": 900, "angle": 0, "strokeColor": "#bbbbbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1445324402, "version": 1, "versionNonce": 1820058495, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "name": "11 · Home in the hive look"}, {"id": "e0635", "type": "rectangle", "x": 0, "y": 4400, "width": 1440, "height": 900, "angle": 0, "strokeColor": "#FBF6EA", "backgroundColor": "#FBF6EA", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "e0634", "roundness": null, "seed": 1121672012, "version": 1, "versionNonce": 89844111, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0636", "type": "rectangle", "x": 0, "y": 4400, "width": 220, "height": 900, "angle": 0, "strokeColor": "#E3D5B4", "backgroundColor": "#F3E9D2", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "e0634", "roundness": null, "