ll, "originalText": "Same place every time (right edge, filled). Secondaries live\nbehind '…'. A card with no action for you is not on Home.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0056", "type": "text", "x": 1400, "y": 624, "width": 669.7600000000001, "height": 16.25, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 649821630, "version": 1, "versionNonce": 996247159, "isDeleted": false, "boundElements": null, "updated": 1789423698668, "link": null, "locked": false, "text": "Tokens change first (styles.css :root), then Home, then the board, then task/decision cards.", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Tokens change first (styles.css :root), then Home, then the board, then task/decision cards.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0057", "type": "frame", "x": 0, "y": 780, "width": 1000, "height": 700, "angle": 0, "strokeColor": "#bbbbbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1002170859, "version": 1, "versionNonce": 51810463, "isDeleted": false, "boundElements": null, "updated": 1789423698668, "link": null, "locked": false, "name": "2 · Style tile A — Paper (light) — recommended"}, {"id": "e0058", "type": "rectangle", "x": 0, "y": 780, "width": 1000, "height": 700, "angle": 0, "strokeColor": "#F6F5F1", "backgroundColor": "#F6F5F1", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "e0057", "roundness": null, "seed": 2082899072, "version": 1, "versionNonce": 783156688, "isDeleted": false, "boundElements": null, "updated": 1789423698668, "link": null, "locked": f