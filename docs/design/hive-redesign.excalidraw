, "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 1564436943, "version": 1, "versionNonce": 2038109497, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "What to check", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What to check", "autoResize": true, "lineHeight": 1.15}, {"id": "e0402", "type": "rectangle", "x": 692, "y": 2772, "width": 716, "height": 58, "angle": 0, "strokeColor": "#FBEFD9", "backgroundColor": "#FBEFD9", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": {"type": 3}, "seed": 130060445, "version": 1, "versionNonce": 1764380431, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0403", "type": "text", "x": 708, "y": 2784, "width": 556.5, "height": 32.199999999999996, "angle": 0, "strokeColor": "#1B1B1A", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 1065207916, "version": 1, "versionNonce": 1738485151, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Rename one 개발 row's project name in the CMS tracker, reload the asset page,\nconfirm the 기사 tab still lists its articles.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Rename one 개발 row's project name in the CMS tracker, reload the asset page,\nconfirm the 기사 tab still lists its articles.", "autoResize": true, "lineHeight": 1.15}, {"id": "e0404", "type": "text", "x": 692, "y": 2854, "width": 82.68, "height": 14.95, "angle": 0, "strokeColor": "#6C6A63", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 174588222, "version": 1, "versionNonce": 1613050845, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "What changed", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What changed", "autoResize": true, "lineHeight": 1.15}, {"id": "e0405", "type": "text", "x": 692, "y": 2876, "width": 660.9100000000001, "height": 33.349999999999994, "angle": 0, "strokeColor": "#1B1B1A", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 149698459, "version": 1, "versionNonce": 1993082228, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Renaming a row's project_name now migrates the matching map_article_link_cms rows\ninside the same transaction as the tracker update. A db spec fails without the change.", "fontSize": 14.5, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Renaming a row's project_name now migrates the matching map_article_link_cms rows\ninside the same transaction as the tracker update. A db spec fails without the change.", "autoResize": true, "lineHeight": 1.15}, {"id": "e0406", "type": "text", "x": 692, "y": 2938, "width": 20.67, "height": 14.95, "angle": 0, "strokeColor": "#6C6A63", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 268778797, "version": 1, "versionNonce": 266304711, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Why", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why", "autoResize": true, "lineHeight": 1.15}, {"id": "e0407", "type": "text", "x": 692, "y": 2960, "width": 645.5400000000001, "height": 33.349999999999994, "angle": 0, "strokeColor": "#1B1B1A", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 1103875131, "version": 1, "versionNonce": 837267154, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "The public 개발 detail page asks for articles by project_name || asset_name.\nAfter a rename the tag still points at the old name, so the tab goes silently empty.", "fontSize": 14.5, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The public 개발 detail page asks for articles by project_name || asset_name.\nAfter a rename the tag still points at the old name, so the tab goes silently empty.", "autoResize": true, "lineHeight": 1.15}, {"id": "e0408", "type": "text", "x": 692, "y": 3022, "width": 55.120000000000005, "height": 14.95, "angle": 0, "strokeColor": "#6C6A63", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0354", "roundness": null, "seed": 269946156, "version": 1, "versionNonce": 1456292563, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Evidence", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Evidence", "autoResize": true, "lineHeight": 1.15}, {"id": "e0409", "type": "rectangle", "x": 692, "y": 3044, "width": 224, "height": 120, "angle": 0, "strokeColor": "#D9D6CC", "backgroun