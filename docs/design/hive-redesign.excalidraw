"opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 1708957521, "version": 1, "versionNonce": 1679116189, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "28 page title · 18 card title · 15 body · 13 meta. No uppercase\neyebrows. Prose is prose, never monospace.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "28 page title · 18 card title · 15 body · 13 meta. No uppercase\neyebrows. Prose is prose, never monospace.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0048", "type": "rectangle", "x": 1400, "y": 420, "width": 44, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": {"type": 3}, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": [{"id": "e0049", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0049", "type": "text", "x": 1416.4, "y": 429.5, "width": 11.200000000000001, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0033", "roundness": null, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "4", "fontSize": 20, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0048", "originalText": "4", "autoResize": true, "lineHeight": 1.25}, {"id": "e0050", "type": "text", "x": 1464, "y": 418, "width": 255.36, "height": 23.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeSty