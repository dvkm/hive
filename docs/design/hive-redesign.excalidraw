d where to stop"}, {"id": "e0611", "type": "text", "x": 1120, "y": 3590, "width": 302.40000000000003, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 2027828066, "version": 1, "versionNonce": 27409231, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "What makes it hive", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What makes it hive", "autoResize": true, "lineHeight": 1.25}, {"id": "e0612", "type": "text", "x": 1120, "y": 3634, "width": 674.24, "height": 17.5, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 113888662, "version": 1, "versionNonce": 1877819864, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Grow the identity out of the mark that already exists: three hexagons, honey on cream.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Grow the identity out of the mark that already exists: three hexagons, honey on cream.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0613", "type": "rectangle", "x": 1120, "y": 3680, "width": 92, "height": 30, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": {"type": 3}, "seed": 1004285694, "version": 1, "versionNonce": 1321779748, "isDeleted": false, "boundElements": [{"id": "e0614", "type": "text"}], "updated": 1789427312879, "link": null, "locked": false}, {"id": "e0614", "type": "text", "x": 1146.4, "y": 3686.25, "width": 39.2, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 910387493, "version": 1, "versionNonce": 1681750514, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Shape", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "e0613", "originalText": "Shape", "autoResize": true, "lineHeight": 1.25}, {"id": "e0615", "type": "text", "x": 1230, "y": 3678, "width": 597.24, "height": 33.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": null, "seed": 334158532, "version": 1, "versionNonce": 736784718, "isDeleted": false, "boundElements": null, "updated": 1789427312879, "link": null, "locked": false, "text": "Hexagon wherever a count or a state already sits: badges, tiles, pips, avatars.\nCards, inputs and panels stay rectangles, because they are read.", "fontSize": 13.5, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Hexagon wherever a count or a state already sits: badges, tiles, pips, avatars.\nCards, inputs and panels stay rectangles, because they are read.", "autoResize": true, "lineHeight": 1.25}, {"id": "e0616", "type": "rectangle", "x": 1120, "y": 3746, "width": 92, "height": 30, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "e0610", "roundness": {"type": 3}, "seed": 621030462, "version": 1, "versionNonce": 141362905, "