{
  "name": "hive-app",
  "productName": "hive",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dir && codesign --force --sign - --requirements '=designated => identifier \"dev.hive.app\"' dist/mac-arm64/hive.app"
  },
  "build": {
    "appId": "dev.hive.app",
    "productName": "hive",
    "protocols": [
      {
        "name": "hive",
        "schemes": ["hive"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": ["main.js"],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
