{
  "name": "hive-app",
  "productName": "hive",
  "version": "0.1.0",
  "description": "Native desktop window and notification client for Hive",
  "author": "Hive contributors",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "install-app": "bun run build && node install-app.js"
  },
  "build": {
    "appId": "dev.hive.app",
    "productName": "hive",
    "protocols": [
      {
        "name": "hive",
        "schemes": ["hive"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "deeplink.js", "windows-server.js"],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
